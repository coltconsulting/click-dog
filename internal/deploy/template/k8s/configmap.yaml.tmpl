apiVersion: v1
kind: ConfigMap
metadata:
  name: click-dog-config
  namespace: click-dog
  labels:
    app.kubernetes.io/name: click-dog
data:
  click-dog.yaml: |
    clickhouse:
      host: {{ yamlScalar .ClickHouseHost }}
      port: 9000
      database: default
      username: ${CLICKHOUSE_USERNAME}
      password: ${CLICKHOUSE_PASSWORD}
      max_open_conns: 2
      max_idle_conns: 1
      query_timeout_s: 30
{{- if .ClickHouseCluster }}
      # Cluster mode: this one instance reads one replica per shard via
      # cluster() queries. Both fields are required — validation rejects
      # use_cluster_queries without a cluster name.
      use_cluster_queries: true
      cluster: {{ yamlScalar .ClickHouseCluster }}
{{- end }}

    exporters:
      otel:
        - collector_address: {{ yamlScalar .CollectorAddress }}
          service_name: click-dog-monitor
{{- if .OTELSecureSet }}
          secure: {{ .OTELSecure }}
{{- if .OTELSecure }}
          # Private CA or mTLS: the Deployment mounts the optional
          # click-dog-otel-ca ConfigMap and click-dog-otel-client Secret at
          # /etc/click-dog/tls/. Uncomment a path only once its source exists.
          # ca_cert: /etc/click-dog/tls/ca.pem
          # client_cert: /etc/click-dog/tls/client.crt
          # client_key: /etc/click-dog/tls/client.key
{{- end }}
{{- else }}
          # secure omitted: plaintext while collector_address is loopback (localhost,
          # 127.0.0.0/8, ::1, unix:), TLS for any other collector. Set it to override.
{{- end }}

    monitor:
      enabled: true
      min_trace_duration_ms: 1000
      check_interval_s: 30
      lookback_s: 40
      max_spans_per_cycle: 1000
      dedup_cache_size: 10000
      circuit_breaker:
        enabled: true
        failure_threshold: 3
        success_threshold: 1
        reset_timeout_s: 60
      backoff:
        enabled: true
        max_interval_s: 300
        backoff_factor: 2.0

    filters:
      blacklist_queries:
        - "^SELECT \\* FROM system\\."
        - "SHOW TABLES"
        - "(?i)healthcheck"
        - "(?i)^SELECT 1$"
        - "(?i)^SELECT version\\(\\)"
      blacklist_operations:
        - "MergeTreeSource"
        - "MergeTreeMarksLoader"
        - "MergeTreeIndex"
        - "MergeTreeSequentialSource"
        - "VFSWrite"
        - "WriteBufferFromS3"
        - "ConcurrentJoin"
        - "QueryPipelineEx"

    log_level: info

    metrics:
      enabled: true
      listen_address: ":9090"
      # admin_listen_address (default: 127.0.0.1:9091) hosts POST /flush.
      # Loopback by default; SIGUSR1 via kubectl exec is the cross-pod
      # equivalent. Don't expose 9091 in a Service or containerPort.
      # admin_listen_address: "127.0.0.1:9091"

    # Dedicated Kubernetes probe endpoints. /healthz is liveness and /readyz
    # reports dependency/circuit-breaker readiness.
    health:
      enabled: true
      listen_address: ":8686"
