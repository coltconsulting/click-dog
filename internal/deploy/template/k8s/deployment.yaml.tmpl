apiVersion: apps/v1
kind: Deployment
metadata:
  name: click-dog
  namespace: click-dog
  labels:
    app.kubernetes.io/name: click-dog
spec:
  # One click-dog instance reads ClickHouse through its Service (see
  # clickhouse.host / use_cluster_queries in the ConfigMap). Generated with
  # --cluster, it runs in cluster mode: cluster() reads one replica per shard,
  # so a replicated cluster gets partial coverage. Without --cluster it reads
  # only the pod the Service routes to. Keep replicas at 1 — multiple instances
  # double-export unless you also enable HA leader election. Do NOT scale this
  # one-per-node; for full coverage, run a sidecar inside every ClickHouse pod
  # instead.
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: click-dog
  strategy:
    type: RollingUpdate
    rollingUpdate:
      # Brief gap during rollouts — fine for a span exporter (spans persist in
      # ClickHouse's log; click-dog resumes via lookback_s). For zero-downtime
      # set maxUnavailable: 0 + maxSurge: 1, but note two instances then briefly
      # overlap and double-export (the collector dedups by span_id).
      maxUnavailable: 1
  template:
    metadata:
      labels:
        app.kubernetes.io/name: click-dog
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "9090"
        prometheus.io/path: "/metrics"
    spec:
      serviceAccountName: click-dog
      terminationGracePeriodSeconds: 15
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        # Kept explicit for older images, which have no passwd entry for
        # 65532: without this they start click-dog in group 0 (root).
        runAsGroup: 65532
        # Group-owns the mounted volumes so the 0440 client key below is
        # readable by click-dog and no one else.
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: click-dog
          image: ghcr.io/coltconsulting/click-dog:{{ .ImageTag }}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          args:
            - "-config"
            - "/etc/click-dog/click-dog.yaml"
          env:
            - name: CLICKHOUSE_USERNAME
              valueFrom:
                secretKeyRef:
                  name: click-dog-secret
                  key: CLICKHOUSE_USERNAME
            - name: CLICKHOUSE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: click-dog-secret
                  key: CLICKHOUSE_PASSWORD
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
          ports:
            - name: metrics
              containerPort: 9090
              protocol: TCP
            - name: health
              containerPort: 8686
              protocol: TCP
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
            initialDelaySeconds: 10
            periodSeconds: 30
          readinessProbe:
            httpGet:
              path: /readyz
              port: health
            initialDelaySeconds: 5
            periodSeconds: 10
          volumeMounts:
            - name: config
              mountPath: /etc/click-dog
              readOnly: true
            - name: otel-tls
              mountPath: /etc/click-dog/tls
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: click-dog-config
        # OTLP TLS material, all optional: the pod starts without either
        # source. Name a file in configmap.yaml (ca_cert, client_cert,
        # client_key under exporters.otel) only once its source exists;
        # click-dog will not start with a TLS file it cannot read.
        - name: otel-tls
          projected:
            sources:
              # CA that signed the collector's server certificate, for a
              # collector on a private CA: ca_cert: /etc/click-dog/tls/ca.pem.
              # Read at startup; restart after changing it.
              - configMap:
                  name: click-dog-otel-ca
                  optional: true
                  items:
                    - key: ca.pem
                      path: ca.pem
              # mTLS client certificate, from any kubernetes.io/tls Secret
              # whose certificate has client auth:
              # client_cert: /etc/click-dog/tls/client.crt and
              # client_key: /etc/click-dog/tls/client.key.
              - secret:
                  name: click-dog-otel-client
                  optional: true
                  items:
                    - key: tls.crt
                      path: client.crt
                    - key: tls.key
                      path: client.key
                      mode: 0440
