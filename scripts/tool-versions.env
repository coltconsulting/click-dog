# Sourced by Make and scripts/doctor.sh. Keep CI pins and installation docs in
# sync when deliberately upgrading a tool.
GO_VERSION=1.26.6
GOLANGCI_LINT_VERSION=v2.12.2
GOVULNCHECK_VERSION=v1.3.0
ACTIONLINT_VERSION=v1.7.7
KUBECONFORM_VERSION=v0.7.0
# Pinned because a shellcheck upgrade can add findings, and this repository's
# release gates are shell: an unpinned bump would fail CI on an unrelated PR.
SHELLCHECK_VERSION=v0.11.0
OPENSPEC_VERSION=1.4.1
# v0.44 retains the JSONL-only mode used by this repository. Beads 1.x uses
# Dolt as its only storage backend and must not be allowed to auto-discover a
# different tracker outside this worktree.
BD_VERSION=0.44.0
MKDOCS_MATERIAL_VERSION=9.7.6
