# Sourced by Make, scripts/doctor.sh, and every GitHub workflow that installs
# a pinned tool, so a bump here moves the local gates and CI together. The
# gates refuse any other version of the tools scripts/lib/tool-pins.sh knows,
# so a bump takes effect locally only after `make dev-setup`. Two pins also
# live where their own tooling reads them and need a matching edit: go.mod's
# `toolchain` line (GO_VERSION) and requirements-docs.txt
# (MKDOCS_MATERIAL_VERSION). scripts/lib/workflow-pins.sh fails `make check`
# on a go.mod that disagrees, and on any version here copied into a workflow.
# Update installation docs that name a version.
GO_VERSION=1.26.10
GOLANGCI_LINT_VERSION=v2.12.2
GOVULNCHECK_VERSION=v1.3.0
ACTIONLINT_VERSION=v1.7.7
KUBECONFORM_VERSION=v0.7.0
# Pinned because a shellcheck upgrade can add findings, and this repository's
# release gates are shell: an unpinned bump would fail CI on an unrelated PR.
SHELLCHECK_VERSION=v0.11.0
OPENSPEC_VERSION=1.4.1
# v0.44 retains the JSONL-only mode used by this repository. Beads 1.x uses
# Dolt as its only storage backend and must not be allowed to auto-discover a
# different tracker outside this worktree.
BD_VERSION=0.44.0
MKDOCS_MATERIAL_VERSION=9.7.6
# One pin for every `wrangler pages deploy`: both site.yml deploy steps source
# this file, and Makefile.internal's local staging deploy reads it via Make.
WRANGLER_VERSION=4.118.0
