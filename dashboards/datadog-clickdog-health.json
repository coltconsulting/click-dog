    {
      "id": 19,
      "definition": {
        "type": "query_table",
        "title": "Per-host health — worst sidecar first (breaker, last-success age, backoff)",
        "title_size": "16",
        "title_align": "left",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "name": "breaker",
                "data_source": "metrics",
                "query": "max:click_dog.circuit_breaker_state{$host} by {host.name}",
                "aggregator": "last"
              },
              {
                "name": "leader",
                "data_source": "metrics",
                "query": "max:click_dog.leader{$host} by {host.name}",
                "aggregator": "last"
              },
              {
                "name": "last_success",
                "data_source": "metrics",
                "query": "min:click_dog.last_success_timestamp_seconds{role:active,$host} by {host.name}",
                "aggregator": "last"
              },
              {
                "name": "backoff",
                "data_source": "metrics",
                "query": "max:click_dog.backoff_interval_seconds{$host} by {host.name}",
                "aggregator": "last"
              },
              {
                "name": "topology",
                "data_source": "metrics",
                "query": "max:click_dog.topology_warning{$host} by {host.name}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "breaker",
                "alias": "circuit breaker",
                "limit": {"count": 100, "order": "desc"},
                "conditional_formats": [
                  {"comparator": "=", "value": 0, "palette": "white_on_green"},
                  {"comparator": "=", "value": 1, "palette": "white_on_yellow"},
                  {"comparator": "=", "value": 2, "palette": "white_on_red"}
                ]
              },
              {
                "formula": "leader",
                "alias": "leader",
                "conditional_formats": [
                  {"comparator": "=", "value": 1, "palette": "white_on_green"},
                  {"comparator": "=", "value": 0, "palette": "white_on_yellow"}
                ]
              },
              {
                "formula": "time() - last_success",
                "alias": "last success age (s)",
                "conditional_formats": [
                  {"comparator": "<", "value": 300, "palette": "white_on_green"},
                  {"comparator": "<", "value": 900, "palette": "white_on_yellow"},
                  {"comparator": ">=", "value": 900, "palette": "white_on_red"}
                ]
              },
              {
                "formula": "backoff",
                "alias": "backoff (s)",
                "conditional_formats": [
                  {"comparator": ">=", "value": 300, "palette": "white_on_red"},
                  {"comparator": ">", "value": 60, "palette": "white_on_yellow"},
                  {"comparator": "<=", "value": 60, "palette": "white_on_green"}
                ]
              },
              {
                "formula": "topology",
                "alias": "topology warning",
                "conditional_formats": [
                  {"comparator": "=", "value": 0, "palette": "white_on_green"},
                  {"comparator": ">", "value": 0, "palette": "white_on_red"}
                ]
              }
            ]
          }
        ]
      },
      "layout": {"x": 0, "y": 4, "width": 12, "height": 4}
