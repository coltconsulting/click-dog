    {
      "id": 1,
      "definition": {
        "title": "Exported queries per minute",
        "title_size": "16",
        "title_align": "left",
        "type": "timeseries",
        "show_legend": false,
        "custom_links": [
          {
            "label": "View matching traces in APM",
            "link": "/apm/traces?query=service:{{$service.value}} resource_name:query @click_dog.source:span_log @hostname:{{$host.value}}"
