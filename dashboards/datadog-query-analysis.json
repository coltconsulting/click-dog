      "definition": {
        "title": "Query latency (p50, p95, p99)",
        "title_size": "16",
        "title_align": "left",
        "type": "timeseries",
        "show_legend": true,
        "legend_layout": "auto",
        "legend_columns": ["avg", "max"],
        "requests": [
          {
            "formulas": [
              {"formula": "query1", "alias": "p50"},
              {"formula": "query2", "alias": "p95"},
              {"formula": "query3", "alias": "p99"}
