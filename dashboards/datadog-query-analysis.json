      "layout": {"x": 6, "y": 3, "width": 2, "height": 2}
    },
    {
      "id": 105,
      "definition": {
        "title": "Top user",
        "title_size": "16",
        "title_align": "left",
        "type": "toplist",
        "requests": [
          {
            "formulas": [{"formula": "query1", "limit": {"count": 1, "order": "desc"}}],
            "queries": [
              {
                "data_source": "spans",
                "name": "query1",
                "search": {"query": "$service resource_name:query @click_dog.source:span_log $env $app $client $host $client_host"},
