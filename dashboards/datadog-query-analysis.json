    {
      "id": 212,
      "definition": {
        "custom_links": [{"label": "View query family traces", "link": "/apm/traces?query=resource_name:query @click_dog.source:span_log {{$service}} {{$env}} {{$app}} {{$user}} {{$client}} {{$host}} {{$client_host}} @query_log.normalized_query_hash:{{@query_log.normalized_query_hash.value}} @query_log.exception_code:>0&from_ts={{timestamp_start}}&to_ts={{timestamp_end}}"}],
        "has_search_bar": "always",
        "title": "Top failing query families",
        "title_size": "16",
        "title_align": "left",
        "type": "query_table",
        "requests": [
          {
            "formulas": [{"formula": "query1", "alias": "failed queries", "limit": {"count": 10, "order": "desc"}}],
            "queries": [
              {
                "data_source": "spans",
                "name": "query1",
                "search": {"query": "$service resource_name:query @click_dog.source:span_log @query_log.exception_code:>0 @query_log.normalized_query_hash:* $env $app $user $client $host $client_host"},
                "indexes": ["*"],
                "compute": {"aggregation": "count"},
