        ],
        "requests": [
          {
            "formulas": [{"formula": "query1"}],
            "queries": [
              {
                "data_source": "spans",
                "name": "query1",
                "search": {
                  "query": "$service resource_name:query @click_dog.source:span_log $env $app $user $client $host $client_host"
