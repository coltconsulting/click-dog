            "queries": [
              {
                "data_source": "spans",
                "name": "query1",
                "search": {"query": "$service resource_name:query @click_dog.source:span_log @query_log.exception_code:>0 @query_log.normalized_query_hash:* $env $app $user $client $host $client_host"},
