            "queries": [
              {
                "data_source": "spans",
                "name": "query1",
                "search": {"query": "$service resource_name:query @click_dog.source:span_log @duration:>1000000000 $env $app $user $client $host $client_host"},
                "indexes": ["*"],
                "compute": {"aggregation": "count"},
                "group_by": []
