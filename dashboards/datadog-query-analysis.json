        "title_size": "16",
        "title_align": "left",
        "type": "timeseries",
        "show_legend": false,
        "custom_links": [{"label": "View matching traces", "link": "/apm/traces?query=resource_name:query @click_dog.source:span_log {{$service}} {{$env}} {{$app}} {{$user}} {{$client}} {{$host}} {{$client_host}}&from_ts={{timestamp_start}}&to_ts={{timestamp_end}}"}],
        "requests": [
          {
            "formulas": [{"formula": "query1"}],
            "queries": [
              {
                "data_source": "spans",
                "name": "query1",
                "search": {
                  "query": "$service resource_name:query @click_dog.source:span_log $env $app $user $client $host $client_host"
