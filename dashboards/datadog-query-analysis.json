            "formulas": [{"formula": "query1"}],
            "queries": [
              {
                "data_source": "spans",
                "name": "query1",
                "search": {"query": "$service resource_name:query @click_dog.source:span_log @query_log.exception_code:>0 $env $app $user $client $host $client_host"},
                "indexes": ["*"],
                "compute": {"aggregation": "count"},
                "group_by": []
