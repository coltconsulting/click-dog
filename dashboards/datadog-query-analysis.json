    {
      "id": 210,
      "definition": {
        "type": "note",
        "content": "## Failures\nFailed queries via `@query_log.exception_code` (`query_log` enrichment only — `span_log` has no error status). Blank = no failures seen, not broken.",
        "background_color": "green",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "center",
        "show_tick": false,
        "has_padding": true
      },
      "layout": {"x": 0, "y": 8, "width": 12, "height": 1}
    },
