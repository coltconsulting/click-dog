{
  "title": "Click-Dog: Application Query Analysis",
  "description": "Live-span-only, application-centric view of ClickHouse queries exported by click-dog from system.opentelemetry_span_log. Complements the official Datadog ClickHouse integration (which covers infrastructure). The first screen is an out-of-box key-metrics summary; automatic live-span enrichment and optional log_comment-tagged attribution come next; exact query families and reference material sit at the bottom. Backfill spans from system.query_log use the separate clickhouse.query/db.* contract and are intentionally outside this dashboard.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "service",
      "prefix": "service",
      "default": "click-dog-monitor"
    },
    {
      "name": "env",
      "prefix": "env",
      "default": "*"
    },
    {
      "name": "app",
      "prefix": "@log_comment.app",
      "default": "*"
    },
    {
      "name": "user",
      "prefix": "@query_log.user",
      "default": "*"
    },
    {
      "name": "client",
      "prefix": "@query_log.client_name",
      "default": "*"
    },
    {
      "name": "host",
      "prefix": "@hostname",
      "default": "*"
    },
    {
      "name": "client_host",
      "prefix": "@query_log.client_hostname",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "id": 10,
      "definition": {
        "type": "note",
        "content": "# Click-Dog — Application Query Analysis\nCounts are exported queries, not total ClickHouse traffic: `monitor.min_trace_duration_ms` and filters select this stream. All widgets use the selected time range.\n\nClick a row for traces; double-click a widget title for full screen.",
        "background_color": "blue",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "top",
        "show_tick": false,
        "has_padding": true
      },
      "layout": {"x": 0, "y": 0, "width": 12, "height": 2}
    },
    {
      "id": 100,
      "definition": {
        "type": "note",
        "content": "## Key Metrics",
        "background_color": "green",
        "font_size": "14",
        "text_align": "left",
        "vertical_align": "center",
        "show_tick": false,
        "has_padding": true
      },
      "layout": {"x": 0, "y": 2, "width": 12, "height": 1}
    },
    {
      "id": 101,
      "definition": {
        "title": "Exported queries",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "formulas": [{"formula": "query1"}],
            "queries": [
              {
                "data_source": "spans",
                "name": "query1",
                "search": {"query": "$service resource_name:query @click_dog.source:span_log $env $app $user $client $host $client_host"},
                "indexes": ["*"],
                "compute": {"aggregation": "count"},
                "group_by": []
              }
            ],
            "response_format": "scalar",
            "conditional_formats": [
              {"comparator": "=", "value": 0, "palette": "white_on_red"},
              {"comparator": ">", "value": 0, "palette": "white_on_green"}
            ]
          }
        ]
      },
      "layout": {"x": 0, "y": 3, "width": 3, "height": 2}
    },
    {
      "id": 102,
      "definition": {
        "title": "p95 latency",
        "title_size": "16",
        "title_align": "left",
        "type": "query_value",
        "autoscale": true,
        "precision": 2,
        "timeseries_background": {"type": "area"},
        "requests": [
          {
            "formulas": [{"formula": "query1"}],
            "queries": [
              {
                "data_source": "spans",
                "name": "query1",
                "search": {"query": "$service resource_name:query @click_dog.source:span_log $env $app $user $client $host $client_host"},
                "indexes": ["*"],
                "compute": {"aggregation": "pc95", "metric": "@duration"},
                "group_by": []
              }
            ],
            "response_format": "scalar"
          }
        ]
      },
      "layout": {"x": 3, "y": 3, "width": 3, "height": 2}
    },
    {
      "id": 103,
      "definition": {
        "title": "p99 latency",
