{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://click-dog.com/schemas/analysis-report-v1.schema.json",
  "title": "Click-Dog Analysis Report",
  "description": "Full deterministic report emitted by click-dog analyze queries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "window",
    "config",
    "coverage",
    "findings",
    "analyzer_runs"
  ],
  "properties": {
    "schema_version": {
      "const": "analysis.report.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "$ref": "#/$defs/window"
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "analysis-finding-v1.schema.json"
      }
    },
    "analyzer_runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/analyzer_run"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clickhouse_host",
        "use_cluster_queries",
        "lookback",
        "timeout",
        "redact_dimensions",
        "min_trace_duration_ms",
        "min_executions",
        "family_limit",
        "span_sample_limit",
        "query_preview_length"
      ],
      "properties": {
        "config_path": {
          "type": "string"
        },
        "clickhouse_host": {
          "type": "string"
        },
        "clickhouse_cluster": {
          "type": "string"
        },
        "use_cluster_queries": {
          "type": "boolean"
        },
        "lookback": {
          "type": "string"
        },
        "timeout": {
          "type": "string"
        },
        "redact_dimensions": {
          "type": "boolean"
        },
        "min_trace_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_trace_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "min_span_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_span_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "min_executions": {
          "type": "integer",
          "minimum": 0
        },
        "family_limit": {
          "type": "integer",
          "minimum": 0
        },
        "span_sample_limit": {
          "type": "integer",
          "minimum": 0
        },
        "query_preview_length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_query_supported",
        "query_family_rollups_supported",
        "query_family_count",
        "span_sample_available",
        "span_sample_size",
        "spans_with_query_id",
        "query_id_ratio",
        "query_log_by_id_lookback_days",
        "attribution_family_count"
      ],
      "properties": {
        "normalized_query_supported": {
          "type": "boolean"
        },
        "query_family_rollups_supported": {
          "type": "boolean"
        },
        "query_family_count": {
          "type": "integer",
          "minimum": 0
        },
        "span_sample_available": {
          "type": "boolean"
        },
        "span_sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "spans_with_query_id": {
          "type": "integer",
          "minimum": 0
        },
        "query_id_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "query_log_by_id_lookback_days": {
          "type": "integer",
          "minimum": 0
        },
        "attribution_family_count": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "analyzer_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "findings", "duration_ms"],
      "properties": {
        "name": {
          "type": "string"
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
