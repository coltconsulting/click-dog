{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://click-dog.com/schemas/analysis-finding-v1.schema.json",
  "title": "Click-Dog Analysis Finding",
  "description": "One deterministic query-analysis observation emitted by click-dog analyze queries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "analyzer",
    "severity",
    "confidence",
    "title",
    "summary",
    "window_start",
    "window_end",
    "evidence",
    "recommendation"
  ],
  "properties": {
    "schema_version": {
      "const": "analysis.finding.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_]+:[a-f0-9]{12}$"
    },
    "analyzer": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "warning", "info"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "normalized_query_hashes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "representative_query": {
      "type": "string"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/evidence_value"
      }
    },
    "recommendation": {
      "type": "string"
    }
  },
  "$defs": {
    "evidence_value": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        }
      ]
    }
  }
}
