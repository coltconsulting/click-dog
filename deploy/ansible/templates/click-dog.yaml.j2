# Rendered by the click-dog Ansible playbook for one sidecar per ClickHouse
# node. Everything except the per-host connection, secret, TLS, and Keeper
# values is the `production` profile (examples/click-dog-production.yaml), and
# TestAnsibleTemplate_MatchesProductionProfile keeps the two identical.
# To tune your fleet, edit your copy of this file before deploying.

clickhouse:
  host: {{ clickhouse_host }}
  port: {{ clickhouse_port }}
  database: system
  username: {{ clickhouse_username }}
  password_file: {{ click_dog_config_dir }}/.secret
  max_open_conns: 2
  max_idle_conns: 1
  query_timeout_s: 30

# filters.query_text_mode controls whether raw SQL crosses the export boundary.
# Use normalized_only or none for privacy-sensitive production environments.
# See https://click-dog.com/filtering/#query-text-export-modes.
exporters:
  otel:
    - collector_address: {{ otel_collector_address }}
      service_name: click-dog-monitor
{% if otel_secure_rendered | bool %}
{% if otel_transport_tls | bool %}
      secure: true
{% else %}
      secure: false
{% endif %}
{% if otel_ca_enabled | bool %}
      # Verifies the collector's server certificate instead of the system roots.
      ca_cert: {{ tls_cert_dir }}/ca.pem
{% endif %}
{% if otel_mtls_enabled | bool %}
      # Client certificate for collectors that require mTLS.
      client_cert: {{ tls_cert_dir }}/client.crt
      client_key: {{ tls_cert_dir }}/client.key
{% endif %}
{% else %}
      # secure omitted: plaintext while collector_address is loopback (localhost,
      # 127.0.0.0/8, ::1, unix:), TLS for any other collector. Set it to override.
{% endif %}

monitor:
  enabled: true
  min_trace_duration_ms: 1000
  check_interval_s: 30
  max_spans_per_cycle: 1000
  dedup_cache_size: 10000
  circuit_breaker:
    enabled: true
    failure_threshold: 3
    success_threshold: 1
    reset_timeout_s: 60
  backoff:
    enabled: true
    max_interval_s: 300
    backoff_factor: 2.0

filters:
  query_text_mode: raw # raw | redacted | normalized_only | none
  blacklist_queries:
    - "^SYSTEM"
    - "^INSERT INTO.*\\.inner\\."
  # Drop high-volume engine-internal spans at the SQL level.
  blacklist_operations:
    - "MergeTreeSource"
    - "MergeTreeMarksLoader"
    - "MergeTreeIndex"
    - "MergeTreeSequentialSource"
    - "VFSWrite"
    - "WriteBufferFromS3"
    - "ConcurrentJoin"
    - "QueryPipelineEx"

metrics:
  enabled: true
  listen_address: ":9090"
  otlp:
    # Push click-dog's own health metrics over OTLP, reusing exporters.otel[0].
    # Feeds the Datadog "Click-Dog: Health" dashboard. Delete to disable.
    enabled: true

health:
  enabled: true
  listen_address: ":8686"

log_level: info
{% if ha_enabled | bool %}

# Optional coordination for a sidecar fleet: cluster-wide `click-dog flush`
# and the leader-served /clusterz. Not needed for coverage.
ha:
  keeper:
    hosts: {{ keeper_hosts }}
    session_timeout_s: 10
    base_path: "/click-dog/election"
{% endif %}
